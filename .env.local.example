# ─── Auth (NextAuth.js v5 / Auth.js) ──────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32 (use the same value for both lines)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Dev mode: true → email-only local login (no Cognito).
# In production set NODE_ENV=production and unset this.
NEXT_PUBLIC_DEV_AUTH=true

# ─── AWS Cognito (prod only; ignored when NEXT_PUBLIC_DEV_AUTH=true) ───────────
COGNITO_CLIENT_ID=placeholder
COGNITO_CLIENT_SECRET=placeholder
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_placeholder

# ─── AWS (region + S3 for future thumbnail mirroring; not required for v1) ─────
AWS_REGION=us-east-1
S3_BUCKET_NAME=postit-thumbs
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder

# ─── Postgres (local Docker; RDS in prod) ─────────────────────────────────────
# Note: docker-compose maps host port 5433 → container 5432 (to avoid clashing
# with sharedboard which runs on 5432). If you're not running sharedboard you
# could drop the offset in docker-compose.yml, but keep the URLs in sync.
DATABASE_URL=postgresql://postgres:password@localhost:5433/postit

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for auto-categorization (gpt-4o-mini) and search embeddings
# (text-embedding-3-small). Create at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# ─── Postit-specific ──────────────────────────────────────────────────────────
# First admin user: during dev-mode signup, if the email matches this, the user
# is marked is_admin=true automatically. Leave empty to bootstrap via SQL.
BOOTSTRAP_ADMIN_EMAIL=
