{
  "name": "postit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_URL=postgresql://postgres:password@localhost:5433/postit next dev",
    "dev:local": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "docker exec -i postgres_postit psql -U postgres -c 'CREATE DATABASE postit;' 2>/dev/null; docker exec -i postgres_postit psql -U postgres -d postit < schema.sql",
    "db:reset": "docker exec -i postgres_postit psql -U postgres -c 'DROP DATABASE IF EXISTS postit;' && npm run db:setup",
    "taxonomy:seed": "DATABASE_URL=postgresql://postgres:password@localhost:5433/postit tsx scripts/seed-taxonomy.ts",
    "items:backfill-embeddings": "DATABASE_URL=postgresql://postgres:password@localhost:5433/postit tsx scripts/backfill-embeddings.ts",
    "items:reprocess-pending": "DATABASE_URL=postgresql://postgres:password@localhost:5433/postit tsx scripts/reprocess-pending-items.ts",
    "demo:seed": "DATABASE_URL=postgresql://postgres:password@localhost:5433/postit tsx scripts/seed-demo-items.ts",
    "bootstrap:local": "bash scripts/local-dev-bootstrap.sh"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1026.0",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-pwa": "^5.6.0",
    "openai": "^6.33.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
